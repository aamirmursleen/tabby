.master-shell(role='main', aria-label='Master Workspace')
    aside.project-rail(aria-label='Founder workspace navigation')
        .rail-header
            .rail-title-row
                span
                    strong Founder command center
                    small {{projectCount}} projects · {{attentionCount}} need attention
                button.icon-button(type='button', title='Project registry', (click)='openRegistry()')
                    i.fas.fa-folder-tree(aria-hidden='true')
            label.rail-search
                i.fas.fa-search(aria-hidden='true')
                input(type='search', [(ngModel)]='projectQuery', placeholder='Filter projects', aria-label='Filter projects')
                button(type='button', (click)='openCommandPalette()', aria-label='Open command palette') ⌘K

        nav.workspace-nav(aria-label='Workspace sections')
            button.workspace-link(type='button', [class.active]='view === "overview"', (click)='showView("overview")')
                i.fas.fa-list(aria-hidden='true')
                span All projects
                small {{projectCount}}
            button.workspace-link(type='button', [class.active]='view === "knowledge"', (click)='showView("knowledge")')
                i.fas.fa-book-open(aria-hidden='true')
                span Knowledge
            button.workspace-link(type='button', [class.active]='view === "settings"', (click)='showView("settings")')
                i.fas.fa-tower-broadcast(aria-hidden='true')
                span Sync & API
                small.relay-live(*ngIf='workspace.lastSyncedAt') Live
            button.workspace-link(type='button', (click)='openRegistry()')
                i.fas.fa-sitemap(aria-hidden='true')
                span Registry

        .project-groups
            section.project-group(*ngIf='attentionProjects.length')
                .group-label.attention
                    span Needs attention
                    small {{attentionProjects.length}}
                button.project-list-item(
                    *ngFor='let project of attentionProjects; trackBy: trackByProject',
                    type='button',
                    [class.active]='selectedProject?.id === project.id && view === "project"',
                    (click)='openProject(project)'
                )
                    span.priority-stripe([class]="'p' + project.priority")
                    span.project-list-copy
                        strong {{project.name}}
                        small([class.danger-text]='project.metadata.health === "down" || project.metadata.work.blocked') {{project.attention.reasons[0]?.label || 'Needs review'}}
                    span.project-list-meta
                        small {{project.progress}}%
                        small
                            span.connection-dot([class.live]='project.liveCount > 0')
                            | {{project.liveCount}}/{{project.connections.length}}
            section.project-group(*ngIf='watchProjects.length')
                .group-label.watch
                    span Watch
                    small {{watchProjects.length}}
                button.project-list-item(
                    *ngFor='let project of watchProjects; trackBy: trackByProject',
                    type='button',
                    [class.active]='selectedProject?.id === project.id && view === "project"',
                    (click)='openProject(project)'
                )
                    span.priority-stripe([class]="'p' + project.priority")
                    span.project-list-copy
                        strong {{project.name}}
                        small {{project.attention.reasons[0]?.label || 'Monitor project'}}
                    span.project-list-meta
                        small {{project.progress}}%
                        small
                            span.connection-dot([class.live]='project.liveCount > 0')
                            | {{project.liveCount}}/{{project.connections.length}}
            section.project-group(*ngIf='steadyProjects.length')
                .group-label.steady
                    span On track
                    small {{steadyProjects.length}}
                button.project-list-item(
                    *ngFor='let project of steadyProjects; trackBy: trackByProject',
                    type='button',
                    [class.active]='selectedProject?.id === project.id && view === "project"',
                    (click)='openProject(project)'
                )
                    span.priority-stripe([class]="'p' + project.priority")
                    span.project-list-copy
                        strong {{project.name}}
                        small {{project.connections.length}} saved connections
                    span.project-list-meta
                        small {{project.progress}}%
                        small
                            span.connection-dot([class.live]='project.liveCount > 0')
                            | {{project.liveCount}}/{{project.connections.length}}
            .empty-rail(*ngIf='visibleProjects.length === 0') No matching projects

        button.relay-footer(type='button', (click)='showView("settings")')
            span.relay-orb([class.configured]='workspace.lastSyncedAt')
            span
                strong {{workspace.lastSyncedAt ? workspace.syncSource + ' connected' : 'Nafran OS API'}}
                small {{workspace.syncLoading ? 'Syncing verified data…' : workspace.lastSyncedAt ? 'Work and revenue · ' + relativeTime(workspace.lastSyncedAt) : 'Waiting for secure API sync'}}
            i.fas.fa-chevron-right(aria-hidden='true')

    section.workspace-main
        .master-error(*ngIf='error || workspace.error || workspace.syncError')
            i.fas.fa-circle-exclamation(aria-hidden='true')
            span {{error || workspace.error || workspace.syncError}}
        .master-status(*ngIf='status') {{status}}
        .master-loading(*ngIf='workspace.loading')
            i.fas.fa-circle-notch.fa-spin(aria-hidden='true')
            span Loading workspace…

        .workspace-scroll(*ngIf='!workspace.loading')
            section.project-page(*ngIf='view === "project" && selectedProject')
                header.project-header
                    .breadcrumbs
                        button(type='button', (click)='showView("overview")') All projects
                        i.fas.fa-chevron-right(aria-hidden='true')
                        span {{selectedProject.name}}
                        small Top of the list · attention score {{selectedProject.attention.score}}
                    .project-heading-row
                        .project-heading
                            .title-line
                                h1 {{selectedProject.name}}
                                span.priority-chip([class]="'p' + selectedProject.priority") P{{selectedProject.priority}} {{selectedProject.priority === 1 ? 'Critical' : selectedProject.priority === 2 ? 'High' : selectedProject.priority === 3 ? 'Normal' : 'Low'}}
                                span.plane-state([class.live]='selectedProject.metadata.plane.status === "live"')
                                    span.connection-dot([class.live]='selectedProject.metadata.plane.status === "live"')
                                    | Plane · {{selectedProject.metadata.plane.identifier || 'unmapped'}} · {{selectedProject.metadata.plane.status}}
                            p {{selectedProject.metadata.description || 'Add a description in Registry to describe this project.'}}
                            .project-links(*ngIf='selectedProject.metadata.links.length')
                                button.link-chip(*ngFor='let link of selectedProject.metadata.links', type='button', (click)='workspace.openLink(link.url)')
                                    i.fas.fa-link(aria-hidden='true')
                                    span {{link.label}}
                                    i.fas.fa-arrow-up-right-from-square(aria-hidden='true')
                            .project-tags(*ngIf='projectTags(selectedProject).length')
                                span(*ngFor='let tag of projectTags(selectedProject)') {{tag}}
                        .project-actions
                            button.action-button.primary(type='button', [disabled]='selectedProject.connections.length === 0', (click)='terminalDrawerOpen = !terminalDrawerOpen')
                                i.fas.fa-terminal(aria-hidden='true')
                                span Terminal
                            button.action-button(type='button', [disabled]='selectedProject.connections.length === 0', (click)='openFirstConnection(selectedProject)')
                                i.fas.fa-arrow-up-right-from-square(aria-hidden='true')
                                span Open as tab
                            button.action-button.feature(type='button', [disabled]='selectedProject.connections.length === 0', (click)='openFeatureConnection(selectedProject)')
                                i.fas.fa-code-branch(aria-hidden='true')
                                span New feature tab
                            button.action-button(type='button', (click)='scanProject(selectedProject)')
                                i.fas.fa-satellite-dish(aria-hidden='true')
                                span Scan server
                            button.action-button(type='button', (click)='openEditor(selectedProject)')
                                i.fas.fa-sitemap(aria-hidden='true')
                                span Registry
                    nav.project-tabs(aria-label='Project sections')
                        button(type='button', [class.active]='projectSection === "summary"', (click)='showProjectSection("summary")') Summary
                        button(type='button', [class.active]='projectSection === "work"', (click)='showProjectSection("work")')
                            | Work items
                            small {{selectedProject.openWork}}
                        button(type='button', [class.active]='projectSection === "knowledge"', (click)='showProjectSection("knowledge")')
                            | Knowledge
                            small {{selectedProject.metadata.knowledge.status}}
                        button(type='button', [class.active]='projectSection === "connections"', (click)='showProjectSection("connections")')
                            | Connections
                            small {{selectedProject.connections.length}}
                        button(type='button', [class.active]='projectSection === "commands"', (click)='showProjectSection("commands")') Commands
                        button(type='button', [class.active]='projectSection === "activity"', (click)='showProjectSection("activity")') Activity

                .project-body
                    section.summary-layout(*ngIf='projectSection === "summary"')
                        .summary-primary
                            article.workspace-card.attention-card
                                .card-title Why it needs attention
                                .attention-reason(*ngFor='let reason of selectedProject.attention.reasons')
                                    span.reason-icon([class]="'reason-' + reason.kind")
                                        i.fas.fa-bolt(aria-hidden='true')
                                    span.reason-copy
                                        strong {{reason.label}}
                                        small {{selectedProject.name}} · attention weight +{{reason.score}}
                                    button(type='button', (click)='reason.kind === "blocked" || reason.kind === "overdue" ? showProjectSection("work") : showProjectSection("connections")') {{reason.kind === 'blocked' || reason.kind === 'overdue' ? 'View items' : 'Open'}}
                                .card-empty(*ngIf='selectedProject.attention.reasons.length === 0') Nothing here needs you right now.
                            article.workspace-card(*ngIf='(selectedProject.metadata.work.items || []).length')
                                .card-title-row
                                    span.card-title Blocked and overdue
                                    button.text-action(type='button', (click)='showProjectSection("work")') All work items →
                                .work-row(*ngFor='let item of selectedProject.metadata.work.items || []')
                                    code {{item.id}}
                                    span
                                        strong {{item.title}}
                                        small {{item.assignee || item.module || 'Unassigned'}}
                                    span.state-pill([class]='item.state') {{workStateLabel(item.state)}}
                            section.environment-section
                                .card-title-row
                                    span.card-title Environments
                                    small {{selectedProject.liveCount}} of {{selectedProject.connections.length}} live
                                .environment-grid
                                    article.environment-card(*ngFor='let item of selectedProject.connections; trackBy: trackByConnection')
                                        .environment-head
                                            strong {{item.label}}
                                            span.connection-status([class]='item.status.state')
                                                span.connection-dot([class.live]='item.status.state === "running"')
                                                | {{statusLabel(item)}}
                                        small {{item.status.detail}}
                                        code(*ngIf='item.status.workingDirectory') {{item.status.workingDirectory}}
                                        code(*ngIf='item.status.tmuxSession') tmux · {{item.status.tmuxSession}}
                                        button.mini-button(type='button', [disabled]='busyConnectionKey !== null', (click)='openConnection(item)')
                                            i.fas.fa-terminal(aria-hidden='true')
                                            span {{item.liveItem ? 'Focus' : 'Connect'}}
                                    .card-empty(*ngIf='selectedProject.connections.length === 0') Add a saved profile to this project in Connections.
                        .summary-secondary
                            article.workspace-card.revenue-card
                                .card-title-row
                                    span.card-title Revenue
                                    .revenue-period-toggle(role='group', aria-label='Revenue period')
                                        button(type='button', [class.active]='revenuePeriod === "current"', (click)='selectRevenuePeriod("current")') This month
                                        button(type='button', [class.active]='revenuePeriod === "previous"', (click)='selectRevenuePeriod("previous")') Last month
                                .revenue-value
                                    strong {{formatMoney(revenueAmount(selectedProject), selectedProject.metadata.revenue.currency)}}
                                    span {{revenueMonthLabel(selectedProject)}}
                                .revenue-rates(*ngIf='hasRevenueRate(selectedProject)')
                                    span.rate-chip(*ngIf='revenueShareRate(selectedProject) !== null')
                                        small Owner rate
                                        strong {{revenueShareRate(selectedProject)}}%
                                    span.rate-chip(*ngIf='revenueDelta(selectedProject) !== null')
                                        small Change rate
                                        strong([class.positive]='(revenueDelta(selectedProject) || 0) >= 0', [class.negative]='(revenueDelta(selectedProject) || 0) < 0') {{formatRevenueDelta(revenueDelta(selectedProject))}}
                                .revenue-chart(*ngIf='selectedProject.metadata.revenue.history.length')
                                    span(*ngFor='let bar of revenueBars(selectedProject)', [class.selected]='isSelectedRevenueMonth(selectedProject, bar.month)', [style.height.px]='bar.height', [title]='bar.month + ": " + formatMoney(bar.amount, selectedProject.metadata.revenue.currency)')
                                .revenue-months(*ngIf='selectedProject.metadata.revenue.history.length')
                                    span(*ngFor='let bar of revenueBars(selectedProject)') {{bar.month.slice(-2)}}
                                p(*ngIf='selectedProject.metadata.revenue.status === "unmapped"') Revenue is not connected yet. Add the trusted source in Registry.
                                p(*ngIf='selectedProject.metadata.revenue.status !== "unmapped"') {{selectedProject.metadata.revenue.history.length}} synced months · {{formatMoney(revenueTotal(selectedProject), selectedProject.metadata.revenue.currency)}} total · {{selectedProject.metadata.revenue.source || 'Manual registry'}}
                                button.text-action.sync-action(type='button', [disabled]='workspace.syncLoading', (click)='syncRemoteData()')
                                    i.fas([class.fa-rotate]='!workspace.syncLoading', [class.fa-circle-notch]='workspace.syncLoading', [class.fa-spin]='workspace.syncLoading', aria-hidden='true')
                                    span {{workspace.syncLoading ? 'Syncing…' : 'Sync now'}}
                            article.workspace-card.progress-card
                                .card-title-row
                                    span.card-title Progress · Plane
                                    small {{selectedProject.metadata.plane.identifier || 'Not mapped'}}
                                .progress-value-large {{selectedProject.progress}}%
                                .progress-track
                                    span([style.width.%]='selectedProject.progress')
                                .progress-stats
                                    span
                                        strong {{selectedProject.metadata.work.completed}}
                                        small Completed
                                    span
                                        strong {{selectedProject.openWork}}
                                        small Open
                                    span
                                        strong {{selectedProject.metadata.work.blocked}}
                                        small Blocked
                                    span
                                        strong {{selectedProject.metadata.work.overdue}}
                                        small Overdue
                            article.workspace-card.knowledge-summary
                                .card-title-row
                                    span.card-title Knowledge · /aamir
                                    span.knowledge-state([class]='selectedProject.metadata.knowledge.status') {{selectedProject.metadata.knowledge.status}}
                                code {{selectedProject.metadata.knowledge.path}}
                                p {{selectedProject.metadata.notes || 'Project knowledge will appear here after the secure relay indexes its /aamir folder.'}}
                                button.mini-button(type='button', (click)='showProjectSection("knowledge")') Open knowledge

                    section.section-panel(*ngIf='projectSection === "work"')
                        .section-intro
                            span
                                h2 Work items
                                p Live Plane work for {{selectedProject.name}}. Details load only when this project is opened.
                            .section-metrics
                                span
                                    strong {{selectedProject.metadata.work.completed}}/{{selectedProject.metadata.work.total || 0}}
                                    small completed
                                button.mini-button(type='button', (click)='openPlaneLinkEditor()')
                                    i.fas.fa-link(aria-hidden='true')
                                    span {{planeWorkspaceURL(selectedProject) ? 'Change Plane link' : 'Paste Plane link'}}
                                button.mini-button(type='button', [disabled]='!planeWorkspaceURL(selectedProject)', (click)='workspace.openLink(planeWorkspaceURL(selectedProject))')
                                    i.fas.fa-arrow-up-right-from-square(aria-hidden='true')
                                    span Open in Plane
                                button.mini-button(type='button', [disabled]='!planeWorkspaceURL(selectedProject) || workspace.isLoadingWorkItems(selectedProject.id)', (click)='syncWorkItems()')
                                    i.fas([class.fa-rotate]='!workspace.isLoadingWorkItems(selectedProject.id)', [class.fa-circle-notch]='workspace.isLoadingWorkItems(selectedProject.id)', [class.fa-spin]='workspace.isLoadingWorkItems(selectedProject.id)', aria-hidden='true')
                                    span {{workspace.isLoadingWorkItems(selectedProject.id) ? 'Syncing…' : 'Sync items'}}
                        form.plane-link-panel(*ngIf='planeLinkEditorOpen', (ngSubmit)='savePlanePortalLink()')
                            .plane-link-copy
                                i.fas.fa-wand-magic-sparkles(aria-hidden='true')
                                span
                                    strong Paste Plane link
                                    small Paste a workspace, project or task URL. Aamir Terminal will map it and fetch its work items.
                            label.plane-link-input
                                i.fas.fa-link(aria-hidden='true')
                                input(type='url', name='planePortalLink', [(ngModel)]='planeLinkDraft', placeholder='https://portal.whitelabel.com.pk/project-name/', autocomplete='off', spellcheck='false', aria-label='Plane project or task link')
                            .plane-link-actions
                                span.plane-link-error(*ngIf='planeLinkError') {{planeLinkError}}
                                button.text-action(type='button', *ngIf='planeWorkspaceURL(selectedProject)', (click)='cancelPlaneLinkEditor()') Cancel
                                button.action-button.primary(type='submit', [disabled]='saving || !planeLinkDraft.trim()')
                                    i.fas([class.fa-circle-notch]='saving', [class.fa-spin]='saving', [class.fa-plug-circle-check]='!saving', aria-hidden='true')
                                    span {{saving ? 'Connecting…' : 'Connect & sync'}}

                        .work-filter-bar(*ngIf='planeWorkspaceURL(selectedProject)')
                            label.work-search
                                i.fas.fa-search(aria-hidden='true')
                                input(type='search', [(ngModel)]='workFilters.query', placeholder='Search tasks, IDs or owners', aria-label='Search work items')
                            label.work-filter
                                span Status
                                select([(ngModel)]='workFilters.status', aria-label='Filter by status')
                                    option(value='all') All statuses
                                    option(value='backlog') Backlog
                                    option(value='todo') Todo
                                    option(value='in_progress') In progress
                                    option(value='blocked') Blocked
                                    option(value='done') Done
                                    option(value='cancelled') Cancelled
                            label.work-filter
                                span Priority
                                select([(ngModel)]='workFilters.priority', aria-label='Filter by priority')
                                    option(value='all') All priorities
                                    option(value='urgent') Urgent
                                    option(value='high') High
                                    option(value='medium') Medium
                                    option(value='low') Low
                                    option(value='none') No priority
                            label.work-filter
                                span Created
                                select([(ngModel)]='workFilters.created', aria-label='Filter by creation date')
                                    option(value='all') All time
                                    option(value='this_month') Created this month
                                    option(value='last_month') Created last month
                            label.work-filter
                                span Due
                                select([(ngModel)]='workFilters.due', aria-label='Filter by due date')
                                    option(value='all') Any due date
                                    option(value='today') Due today
                                    option(value='next_7_days') Next 7 days
                                    option(value='this_month') Due this month
                                    option(value='overdue') Overdue
                                    option(value='no_due_date') No due date
                            .work-view-actions
                                button.text-action(type='button', *ngIf='hasActiveWorkFilters()', (click)='clearWorkFilters()') Clear
                                .work-view-toggle(role='group', aria-label='Work item view')
                                    button(type='button', [class.active]='workView === "kanban"', (click)='workView = "kanban"')
                                        i.fas.fa-table-columns(aria-hidden='true')
                                        span Kanban
                                    button(type='button', [class.active]='workView === "list"', (click)='workView = "list"')
                                        i.fas.fa-list(aria-hidden='true')
                                        span List

                        .work-result-summary(*ngIf='planeWorkspaceURL(selectedProject) && workspace.hasLoadedWorkItems(selectedProject.id) && !workspace.isLoadingWorkItems(selectedProject.id)')
                            strong {{filteredWorkItems(selectedProject).length}}
                            span of {{(selectedProject.metadata.work.items || []).length}} tasks shown

                        .work-surface(*ngIf='planeWorkspaceURL(selectedProject)')
                            .card-empty(*ngIf='workspace.isLoadingWorkItems(selectedProject.id)') Loading current work items from Plane…
                            .card-empty.error-empty(*ngIf='!workspace.isLoadingWorkItems(selectedProject.id) && workspace.workItemsError(selectedProject.id)')
                                span {{workspace.workItemsError(selectedProject.id)}}
                                button.mini-button(type='button', (click)='syncWorkItems()') Retry

                            .work-kanban(*ngIf='!workspace.isLoadingWorkItems(selectedProject.id) && !workspace.workItemsError(selectedProject.id) && workView === "kanban" && filteredWorkItems(selectedProject).length')
                                section.kanban-column(*ngFor='let column of workKanbanColumns(selectedProject); trackBy: trackByKanbanColumn', [class]="'kanban-column state-' + column.key")
                                    header.kanban-column-header
                                        span.state-marker
                                        strong {{column.label}}
                                        small {{column.items.length}}
                                    .kanban-column-body
                                        article.kanban-card(*ngFor='let item of column.items; trackBy: trackByWorkItem')
                                            .kanban-card-head
                                                code {{item.id}}
                                                button.icon-button(type='button', [disabled]='!planeWorkItemURL(selectedProject, item)', title='Open in Plane', aria-label='Open work item in Plane', (click)='workspace.openLink(planeWorkItemURL(selectedProject, item))')
                                                    i.fas.fa-arrow-up-right-from-square(aria-hidden='true')
                                            h3 {{item.title}}
                                            .kanban-card-badges
                                                span.priority-pill([class]="'priority-' + item.priority") {{workPriorityLabel(item.priority)}}
                                            .kanban-card-owner
                                                i.far.fa-user(aria-hidden='true')
                                                span {{item.assignee || item.module || 'Unassigned'}}
                                            .kanban-card-dates
                                                span(*ngIf='item.createdAt', [title]="'Created ' + item.createdAt")
                                                    i.far.fa-calendar-plus(aria-hidden='true')
                                                    | {{formatWorkDate(item.createdAt)}}
                                                span(*ngIf='item.dueDate', [class.overdue]='isWorkItemOverdue(item)', [title]="'Due ' + item.dueDate")
                                                    i.far.fa-calendar-check(aria-hidden='true')
                                                    | Due {{formatWorkDate(item.dueDate)}}
                                        .kanban-column-empty(*ngIf='!column.items.length') No {{column.label.toLocaleLowerCase()}} tasks

                            .work-table.filtered-work-table(*ngIf='!workspace.isLoadingWorkItems(selectedProject.id) && !workspace.workItemsError(selectedProject.id) && workView === "list" && filteredWorkItems(selectedProject).length')
                                .work-row.header
                                    span ID
                                    span Work item
                                    span Priority
                                    span Owner / module
                                    span Due
                                    span State
                                    span
                                .work-row(*ngFor='let item of filteredWorkItems(selectedProject); trackBy: trackByWorkItem')
                                    code {{item.id}}
                                    span
                                        strong {{item.title}}
                                        small(*ngIf='item.createdAt') Created {{formatWorkDate(item.createdAt)}}
                                    span.priority-pill([class]="'priority-' + item.priority") {{workPriorityLabel(item.priority)}}
                                    span {{item.assignee || item.module || 'Unassigned'}}
                                    span.work-due([class.overdue]='isWorkItemOverdue(item)') {{item.dueDate ? formatWorkDate(item.dueDate) : '—'}}
                                    span.state-pill([class]='item.state') {{workStateLabel(item.state)}}
                                    button.icon-button(type='button', [disabled]='!planeWorkItemURL(selectedProject, item)', title='Open in Plane', aria-label='Open work item in Plane', (click)='workspace.openLink(planeWorkItemURL(selectedProject, item))')
                                        i.fas.fa-arrow-up-right-from-square(aria-hidden='true')

                            .card-empty(*ngIf='!workspace.isLoadingWorkItems(selectedProject.id) && workspace.hasLoadedWorkItems(selectedProject.id) && !(selectedProject.metadata.work.items || []).length') No work items are currently available in this Plane workspace.
                            .card-empty(*ngIf='!workspace.isLoadingWorkItems(selectedProject.id) && workspace.hasLoadedWorkItems(selectedProject.id) && (selectedProject.metadata.work.items || []).length && !filteredWorkItems(selectedProject).length') No tasks match these filters.

                    section.section-panel(*ngIf='projectSection === "knowledge"')
                        .section-intro
                            span
                                h2 My knowledge
                                p Private project context, notes and useful links saved with this project.
                            .knowledge-header-actions
                                button.action-button(type='button', (click)='openKnowledgeNoteEditor()')
                                    i.fas.fa-note-sticky(aria-hidden='true')
                                    span {{selectedProject.metadata.notes ? 'Edit note' : 'Add note'}}
                                button.action-button.primary(type='button', (click)='openKnowledgeLinkEditor()')
                                    i.fas.fa-link(aria-hidden='true')
                                    span Add link
                        .knowledge-grid
                            article.workspace-card.knowledge-note-card
                                .card-title-row
                                    span.card-title Founder note
                                    small Saved locally · {{selectedProject.name}}
                                p.knowledge-note(*ngIf='selectedProject.metadata.notes') {{selectedProject.metadata.notes}}
                                .knowledge-empty(*ngIf='!selectedProject.metadata.notes && knowledgeEditorMode !== "note"')
                                    i.far.fa-note-sticky(aria-hidden='true')
                                    strong Keep the context that matters
                                    span Add decisions, current focus, useful commands or the next action for this project.
                                    button.text-action(type='button', (click)='openKnowledgeNoteEditor()') Add note
                                form.knowledge-editor(*ngIf='knowledgeEditorMode === "note"', (ngSubmit)='saveKnowledgeNote()')
                                    label.field-label
                                        span Project note
                                        textarea(name='knowledgeNote', [(ngModel)]='knowledgeNoteDraft', rows='9', maxlength='20000', placeholder='Decisions, context, current focus, useful commands and next actions…')
                                    .knowledge-error(*ngIf='knowledgeError') {{knowledgeError}}
                                    .knowledge-editor-footer
                                        small {{knowledgeNoteDraft.length | number}} / 20,000
                                        span
                                            button.action-button(type='button', [disabled]='saving', (click)='cancelKnowledgeEditor()') Cancel
                                            button.action-button.primary(type='submit', [disabled]='saving') {{saving ? 'Saving…' : 'Save note'}}

                            article.workspace-card.knowledge-links-card
                                .card-title-row
                                    span.card-title Saved links
                                    small {{selectedProject.metadata.links.length}} {{selectedProject.metadata.links.length === 1 ? 'link' : 'links'}}
                                .knowledge-link-list(*ngIf='selectedProject.metadata.links.length')
                                    .knowledge-link-row(*ngFor='let link of selectedProject.metadata.links; let index = index')
                                        button.knowledge-link-main(type='button', (click)='workspace.openLink(link.url)', [title]='link.url')
                                            span.knowledge-link-icon
                                                i.fas.fa-link(aria-hidden='true')
                                            span
                                                strong {{link.label}}
                                                small {{link.url}}
                                            i.fas.fa-arrow-up-right-from-square(aria-hidden='true')
                                        span.knowledge-link-actions
                                            button.icon-button(type='button', title='Edit link', aria-label='Edit link', (click)='openKnowledgeLinkEditor(index)')
                                                i.fas.fa-pen(aria-hidden='true')
                                            button.icon-button.danger-action(type='button', title='Remove link', aria-label='Remove link', [disabled]='saving', (click)='removeKnowledgeLink(index)')
                                                i.fas.fa-trash(aria-hidden='true')
                                .knowledge-empty(*ngIf='!selectedProject.metadata.links.length && knowledgeEditorMode !== "link"')
                                    i.fas.fa-link(aria-hidden='true')
                                    strong Keep every useful project link together
                                    span Save dashboards, documentation, repositories, designs or production URLs.
                                    button.text-action(type='button', (click)='openKnowledgeLinkEditor()') Add link
                                form.knowledge-editor(*ngIf='knowledgeEditorMode === "link"', (ngSubmit)='saveKnowledgeLink()')
                                    label.field-label
                                        span Link name
                                        input(type='text', name='knowledgeLinkLabel', [(ngModel)]='knowledgeLinkDraft.label', maxlength='80', placeholder='Production dashboard')
                                    label.field-label
                                        span URL
                                        input(type='url', name='knowledgeLinkURL', [(ngModel)]='knowledgeLinkDraft.url', maxlength='2048', placeholder='https://…')
                                    .knowledge-error(*ngIf='knowledgeError') {{knowledgeError}}
                                    .knowledge-editor-footer
                                        small HTTP and HTTPS links only
                                        span
                                            button.action-button(type='button', [disabled]='saving', (click)='cancelKnowledgeEditor()') Cancel
                                            button.action-button.primary(type='submit', [disabled]='saving') {{saving ? 'Saving…' : knowledgeEditingLinkIndex === null ? 'Save link' : 'Update link'}}

                            article.workspace-card.knowledge-source-card
                                .card-title-row
                                    span.card-title Server knowledge
                                    span.knowledge-state([class]='selectedProject.metadata.knowledge.status') {{selectedProject.metadata.knowledge.status}}
                                code {{selectedProject.metadata.knowledge.path}}
                                p Current project context from the registered server folder. Your note and saved links stay local when server data refreshes.
                                button.mini-button(type='button', (click)='scanProject(selectedProject)')
                                    i.fas.fa-rotate(aria-hidden='true')
                                    span Refresh knowledge

                    section.section-panel(*ngIf='projectSection === "connections"')
                        .section-intro
                            span
                                h2 Connections
                                p Saved and live environments. A server starts only when you click it.
                            button.action-button(type='button', (click)='connectionsRequested.emit()') Open navigator
                        .connections-grid
                            article.environment-card(*ngFor='let item of selectedProject.connections; trackBy: trackByConnection')
                                .environment-head
                                    strong {{item.label}}
                                    span.connection-status([class]='item.status.state') {{statusLabel(item)}}
                                small {{item.status.detail}}
                                code(*ngIf='item.status.workingDirectory') {{item.status.workingDirectory}}
                                code(*ngIf='item.status.tmuxSession') tmux · {{item.status.tmuxSession}}
                                button.action-button(type='button', [disabled]='busyConnectionKey !== null', (click)='openConnection(item)') {{item.liveItem ? 'Focus terminal' : 'Connect'}}
                            .card-empty(*ngIf='selectedProject.connections.length === 0') No connections are assigned to this project.

                    section.section-panel(*ngIf='projectSection === "commands"')
                        .section-intro
                            span
                                h2 Commands
                                p Run saved command groups for this project without duplicating snippets.
                            button.action-button.primary(type='button', (click)='snippetsRequested.emit()') Open snippets
                        article.workspace-card.command-help
                            i.fas.fa-code(aria-hidden='true')
                            span
                                strong Project command library
                                p Group deploy, logs, migrations and health checks in Snippets, then run them in the selected connection.

                    section.section-panel(*ngIf='projectSection === "activity"')
                        .section-intro
                            span
                                h2 Activity
                                p Local project and session activity.
                        article.workspace-card.activity-list
                            .activity-row
                                i.fas.fa-clock(aria-hidden='true')
                                span Project registry updated
                                small {{relativeTime(selectedProject.metadata.lastActivityAt)}}
                            .activity-row(*ngFor='let item of selectedProject.connections; trackBy: trackByConnection')
                                i.fas.fa-terminal(aria-hidden='true')
                                span {{item.label}} · {{statusLabel(item)}}
                                small {{item.status.workingDirectory || item.status.tmuxSession || item.status.detail}}

            section.overview-page(*ngIf='view === "overview"')
                .page-heading
                    span
                        h1 All projects
                        p Ordered by production health, blocked and overdue work, priority, Plane sync, and resumable sessions.
                    button.action-button.primary(type='button', (click)='openCommandPalette()')
                        i.fas.fa-search(aria-hidden='true')
                        span Search & commands
                .overview-metrics
                    article
                        strong {{projectCount}}
                        span Projects
                    article
                        strong.danger-text {{attentionCount}}
                        span Need attention
                    article
                        strong.positive {{liveConnectionCount}}
                        span Live sessions
                    article
                        strong {{totalCompleted}}
                        span Work completed
                .project-overview-table
                    .overview-row.header
                        span Project
                        span Progress
                        span Revenue · live
                        span Open work
                        span Servers · tmux
                        span Knowledge · /aamir
                        span Activity
                    button.overview-row(*ngFor='let project of visibleProjects; trackBy: trackByProject', type='button', (click)='openProject(project)')
                        span.project-name-cell
                            span.priority-chip([class]="'p' + project.priority") P{{project.priority}}
                            span
                                strong {{project.name}}
                                small {{project.attention.reasons[0]?.label || project.metadata.description}}
                        span
                            strong {{project.progress}}%
                            small {{project.metadata.work.completed}}/{{project.metadata.work.total || 0}} complete
                        span
                            strong {{formatMoney(project.metadata.revenue.currentMonthly, project.metadata.revenue.currency)}}
                            small {{project.metadata.revenue.status}}
                        span
                            strong {{project.openWork}}
                            small {{project.metadata.work.blocked}} blocked
                        span
                            strong {{project.liveCount}}/{{project.connections.length}} live
                            small {{project.connections[0]?.status?.tmuxSession || 'On demand'}}
                        span
                            strong {{project.metadata.knowledge.status}}
                            small {{project.metadata.knowledge.path}}
                        span
                            strong {{relativeTime(project.metadata.lastActivityAt)}}
                            small Score {{project.attention.score}}

            section.global-page(*ngIf='view === "knowledge"')
                .page-heading
                    span
                        h1 Knowledge · /aamir
                        p Every project’s registered knowledge source, without exposing credentials in the dashboard.
                .global-grid
                    button.global-card(*ngFor='let project of projects; trackBy: trackByProject', type='button', (click)='openProject(project); showProjectSection("knowledge")')
                        .card-title-row
                            strong {{project.name}}
                            span.knowledge-state([class]='project.metadata.knowledge.status') {{project.metadata.knowledge.status}}
                        code {{project.metadata.knowledge.path}}
                        p {{project.metadata.notes || project.metadata.description}}

            section.global-page(*ngIf='view === "work"')
                .page-heading
                    span
                        h1 Work across projects
                        p Completed, open, blocked and overdue work from Plane and the local snapshot.
                .global-grid
                    button.global-card(*ngFor='let project of projects; trackBy: trackByProject', type='button', (click)='openProject(project); showProjectSection("work")')
                        .card-title-row
                            strong {{project.name}}
                            span.priority-chip([class]="'p' + project.priority") P{{project.priority}}
                        .progress-value-large {{project.progress}}%
                        .progress-track
                            span([style.width.%]='project.progress')
                        p {{project.metadata.work.completed}} done · {{project.openWork}} open · {{project.metadata.work.blocked}} blocked

            section.global-page(*ngIf='view === "connections"')
                .page-heading
                    span
                        h1 Saved and live connections
                        p Servers remain offline until you choose one.
                    button.action-button(type='button', (click)='connectionsRequested.emit()') Open navigator
                .global-grid
                    article.global-card(*ngFor='let project of projects; trackBy: trackByProject')
                        .card-title-row
                            strong {{project.name}}
                            small {{project.liveCount}}/{{project.connections.length}} live
                        button.connection-line(*ngFor='let item of project.connections; trackBy: trackByConnection', type='button', (click)='openConnection(item)')
                            span.connection-dot([class.live]='item.status.state === "running"')
                            span
                                strong {{item.label}}
                                small {{statusLabel(item)}}
                            i.fas.fa-play(aria-hidden='true')

            section.global-page.settings-page(*ngIf='view === "settings"')
                .page-heading
                    span
                        h1 Sync & API
                        p Verified Plane work and owner-share revenue arrive directly from the protected Nafran OS API.
                article.settings-card
                    .settings-status
                        span.relay-orb([class.configured]='workspace.lastSyncedAt')
                        span
                            strong {{workspace.lastSyncedAt ? workspace.syncSource + ' connected' : 'Connecting to Nafran OS API'}}
                            small {{workspace.lastSyncedAt ? 'Last verified ' + relativeTime(workspace.lastSyncedAt) + ' · refreshes every minute' : 'The first secure sync will run automatically.'}}
                    .security-note
                        i.fas.fa-shield-halved(aria-hidden='true')
                        span Cloudflare Access credentials are stored in macOS Keychain. The app reads only project work, health and owner-share revenue from allowlisted HTTPS endpoints.
                    button.action-button.primary(type='button', [disabled]='workspace.syncLoading', (click)='syncRemoteData()')
                        i.fas([class.fa-rotate]='!workspace.syncLoading', [class.fa-circle-notch]='workspace.syncLoading', [class.fa-spin]='workspace.syncLoading', aria-hidden='true')
                        span {{workspace.syncLoading ? 'Syncing verified data…' : 'Sync now'}}

        footer.terminal-drawer(*ngIf='view === "project" && selectedProject', [class.open]='terminalDrawerOpen')
            button.drawer-heading(type='button', (click)='terminalDrawerOpen = !terminalDrawerOpen')
                i.fas.fa-terminal(aria-hidden='true')
                strong Terminal
                span {{selectedProject.name}} · {{selectedProject.connections[0]?.label || 'No connection selected'}}
                small {{selectedProject.connections[0]?.status?.tmuxSession ? 'tmux ' + selectedProject.connections[0]?.status?.tmuxSession : selectedProject.connections[0]?.status?.workingDirectory || ''}}
                i.fas([class.fa-chevron-up]='!terminalDrawerOpen', [class.fa-chevron-down]='terminalDrawerOpen', aria-hidden='true')
            .drawer-content(*ngIf='terminalDrawerOpen')
                button.drawer-connection(*ngFor='let item of selectedProject.connections; trackBy: trackByConnection', type='button', (click)='openConnection(item)')
                    span.connection-dot([class.live]='item.status.state === "running"')
                    span
                        strong {{item.label}}
                        small {{item.status.workingDirectory || item.status.tmuxSession || item.status.detail}}
                    span {{item.liveItem ? 'Focus' : 'Open'}}
                .card-empty(*ngIf='selectedProject.connections.length === 0') Add a saved connection in the project registry.

    .command-backdrop(*ngIf='commandPaletteOpen', (mousedown)='commandPaletteOpen = false')
        section.command-palette(role='dialog', aria-modal='true', aria-label='Command palette', (mousedown)='$event.stopPropagation()')
            label.command-search
                i.fas.fa-search(aria-hidden='true')
                input.master-command-input(type='search', [(ngModel)]='commandQuery', placeholder='Search projects, servers, tmux, folders or commands', aria-label='Search projects, servers, folders and commands')
                kbd ESC
            .command-results
                button.command-result(*ngFor='let result of searchResults; trackBy: trackBySearchResult', type='button', (click)='chooseSearchResult(result)')
                    span.result-icon
                        i.fas([class]="'fas ' + result.icon", aria-hidden='true')
                    span.result-copy
                        strong {{result.label}}
                        small {{result.detail}}
                    span.result-kind {{result.kind}}
                .card-empty(*ngIf='searchResults.length === 0') No project, server, folder or command matched.

    .modal-backdrop(*ngIf='editorOpen', (mousedown)='editorOpen = false')
        form.project-editor(role='dialog', aria-modal='true', aria-label='Edit project registry', (mousedown)='$event.stopPropagation()', (ngSubmit)='saveProject()')
            .editor-head
                span
                    small PROJECT REGISTRY
                    strong {{selectedProject?.name}}
                button.icon-button(type='button', aria-label='Close project editor', (click)='editorOpen = false')
                    i.fas.fa-xmark(aria-hidden='true')
            .editor-body
                .editor-grid
                    label.field-label
                        span Priority
                        select(name='priority', [(ngModel)]='draft.priority')
                            option([ngValue]='1') P1 · Critical
                            option([ngValue]='2') P2 · High
                            option([ngValue]='3') P3 · Normal
                            option([ngValue]='4') P4 · Low
                    label.field-label
                        span Production health
                        select(name='health', [(ngModel)]='draft.health')
                            option(value='unknown') Unknown
                            option(value='healthy') Healthy
                            option(value='degraded') Degraded
                            option(value='down') Down
                label.field-label
                    span Description
                    input(type='text', name='description', [(ngModel)]='draft.description', maxlength='2000', placeholder='What this project does')
                label.field-label
                    span Founder notes
                    textarea(name='notes', [(ngModel)]='draft.notes', rows='4', maxlength='20000', placeholder='Current focus, decisions and next action')
                .editor-grid.four
                    label.field-label
                        span Total work
                        input(type='number', name='total', [(ngModel)]='draft.total', min='0')
                    label.field-label
                        span Completed
                        input(type='number', name='completed', [(ngModel)]='draft.completed', min='0')
                    label.field-label
                        span Blocked
                        input(type='number', name='blocked', [(ngModel)]='draft.blocked', min='0')
                    label.field-label
                        span Overdue
                        input(type='number', name='overdue', [(ngModel)]='draft.overdue', min='0')
                .editor-grid
                    label.field-label
                        span Knowledge path
                        input(type='text', name='knowledgePath', [(ngModel)]='draft.knowledgePath', placeholder='/aamir')
                    label.field-label
                        span Plane identifier
                        input(type='text', name='planeIdentifier', [(ngModel)]='draft.planeIdentifier', placeholder='MS')
                .editor-grid
                    label.field-label
                        span Monthly revenue
                        input(type='number', name='revenueCurrent', [(ngModel)]='draft.revenueCurrent', min='0')
                    label.field-label
                        span Currency
                        input(type='text', name='revenueCurrency', [(ngModel)]='draft.revenueCurrency', maxlength='3', placeholder='USD')
                label.field-label
                    span Revenue source
                    input(type='text', name='revenueSource', [(ngModel)]='draft.revenueSource', maxlength='120', placeholder='Stripe, billing database, manual')
                label.field-label
                    span Revenue history · oldest to newest
                    input(type='text', name='revenueHistory', [(ngModel)]='draft.revenueHistory', placeholder='5200, 5600, 6100, …')
            .editor-actions
                button.action-button(type='button', (click)='editorOpen = false') Cancel
                button.action-button.primary(type='submit', [disabled]='saving') {{saving ? 'Saving…' : 'Save project'}}
